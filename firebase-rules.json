{
  "rules": {
    "cities": {
      "$cityId": {
        "general": {
          ".read": true,
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() >= 2"
        },
        "locations": {
          ".read": true,
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'"
        },
        "routes": {
          ".read": true,
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'"
        },
        "reviews": {
          ".read": true,
          "$placeKey": {
            ".read": true,
            "$userId": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $userId",
              ".validate": "newData.hasChildren(['rating', 'timestamp'])"
            }
          }
        }
      }
    },
    "settings": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() >= 2",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() >= 2"
    },
    "customInterests": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() >= 1"
    },
    "helpContent": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() >= 2"
    },
    "helpAudio": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() >= 2"
    },
    "helpAudioDuration": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() >= 2"
    },
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() >= 2",
      "$uid": {
        ".read": true,
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() >= 2)"
      }
    },
    "accessStats": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() >= 2",
      ".write": "auth != null"
    },
    "feedback": {
      ".read": "auth != null",
      "$feedbackId": {
        ".write": "auth != null && (!data.exists() && newData.child('userId').val() === auth.uid || data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() >= 2)",
        ".validate": "newData.hasChildren(['text', 'userId', 'timestamp'])"
      },
      ".indexOn": ["timestamp"]
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
